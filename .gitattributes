# Normalise to LF in the repo; Git checks out CRLF on Windows where it matters.
* text=auto eol=lf

*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf

*.woff2  binary
*.png    binary
*.ico    binary
*.exe    binary
*.zip    binary

# The approved design extraction — keep byte-identical to the handoff.
src/renderer/styles/burn-system.css -text
reference/**                        -text
